#!/bin/bash
set -e

# Integration test for PostgreSQL LISTEN/NOTIFY functionality
# This script requires a running PostgreSQL instance

cd $(dirname $0)/..

POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
POSTGRES_USER="${POSTGRES_USER:-postgres}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-postgres}"
POSTGRES_DB="kine_integration_test_$(date +%s)"

echo "=== PostgreSQL Integration Test for Kine Notifications ==="
echo "Host: $POSTGRES_HOST:$POSTGRES_PORT"
echo "User: $POSTGRES_USER"
echo "Test Database: $POSTGRES_DB"
echo

# Cleanup function
cleanup() {
    echo "Cleaning up..."
    if [ -n "$KINE_PID" ]; then
        kill $KINE_PID 2>/dev/null || true
        wait $KINE_PID 2>/dev/null || true
    fi
    
    # Drop test database
    PGPASSWORD="$POSTGRES_PASSWORD" dropdb -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" "$POSTGRES_DB" 2>/dev/null || true
    echo "Cleanup complete"
}

trap cleanup EXIT

# Check PostgreSQL connectivity
check_postgres() {
    echo "Checking PostgreSQL connectivity..."
    if ! pg_isready -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" >/dev/null 2>&1; then
        echo "❌ PostgreSQL not available at $POSTGRES_HOST:$POSTGRES_PORT"
        echo "Please ensure PostgreSQL is running and accessible"
        exit 1
    fi
    echo "✓ PostgreSQL is available"
}

# Create test database
create_test_db() {
    echo "Creating test database: $POSTGRES_DB"
    PGPASSWORD="$POSTGRES_PASSWORD" createdb -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$POSTGRES_USER" "$POSTGRES_DB"
    echo "✓ Test database created"
}

# Build Kine
build_kine() {
    echo "Building Kine..."
    if ! make build 2>/dev/null; then
        echo "Build failed. Attempting with go build..."
        go build -o bin/kine .
    fi
    echo "✓ Kine built successfully"
}

# Test notification functionality
test_notifications() {
    local disable_notifications="$1"
    local test_name="$2"
    
    echo
    echo "=== Test: $test_name ==="
    
    # Prepare Kine command
    local postgres_url="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB?sslmode=disable"
    local kine_cmd="./bin/kine --endpoint=\"$postgres_url\""
    
    if [ "$disable_notifications" = "true" ]; then
        kine_cmd="$kine_cmd --disable-notifications"
    fi
    
    echo "Starting Kine server..."
    echo "Command: $kine_cmd"
    
    # Start Kine in background
    $kine_cmd --debug --listen-address="127.0.0.1:12379" > kine.log 2>&1 &
    KINE_PID=$!
    
    # Wait for Kine to start
    echo "Waiting for Kine to start..."
    local retries=30
    while [ $retries -gt 0 ]; do
        if nc -z 127.0.0.1 12379 2>/dev/null; then
            break
        fi
        sleep 1
        retries=$((retries - 1))
    done
    
    if [ $retries -eq 0 ]; then
        echo "❌ Kine failed to start"
        cat kine.log
        return 1
    fi
    
    echo "✓ Kine started successfully"
    
    # Check if notifications are enabled
    if [ "$disable_notifications" != "true" ]; then
        if grep -q "PostgreSQL notification listener started" kine.log; then
            echo "✓ Notification listener started"
        else
            echo "❌ Notification listener not found in logs"
            cat kine.log
            return 1
        fi
    else
        if grep -q "PostgreSQL event-driven notifications disabled" kine.log; then
            echo "✓ Notifications correctly disabled"
        else
            echo "❌ Expected notifications to be disabled"
            cat kine.log
            return 1
        fi
    fi
    
    # Test basic etcd operations
    echo "Testing basic etcd operations..."
    
    # Set a key
    if ! timeout 10s etcdctl --endpoints=127.0.0.1:12379 put test-key test-value; then
        echo "❌ Failed to set key"
        return 1
    fi
    echo "✓ Successfully set key"
    
    # Get the key
    local value=$(timeout 10s etcdctl --endpoints=127.0.0.1:12379 get test-key --print-value-only)
    if [ "$value" != "test-value" ]; then
        echo "❌ Failed to get correct value. Expected: test-value, Got: $value"
        return 1
    fi
    echo "✓ Successfully retrieved key"
    
    # Test watch functionality
    echo "Testing watch functionality..."
    timeout 5s etcdctl --endpoints=127.0.0.1:12379 watch test-watch-key &
    local watch_pid=$!
    
    sleep 1
    etcdctl --endpoints=127.0.0.1:12379 put test-watch-key watch-value &
    
    # Wait for watch to complete
    wait $watch_pid 2>/dev/null || true
    echo "✓ Watch test completed"
    
    # Check for notification metrics (if notifications enabled)
    if [ "$disable_notifications" != "true" ]; then
        echo "Checking notification metrics..."
        if curl -s http://127.0.0.1:8080/metrics | grep -q "kine_notifications_total"; then
            echo "✓ Notification metrics available"
            curl -s http://127.0.0.1:8080/metrics | grep "kine_notifications"
        else
            echo "⚠️  Notification metrics not found (may be normal if no notifications occurred)"
        fi
    fi
    
    # Stop Kine
    kill $KINE_PID 2>/dev/null || true
    wait $KINE_PID 2>/dev/null || true
    KINE_PID=""
    
    echo "✓ Test $test_name completed successfully"
    echo
}

# Performance test
performance_test() {
    echo "=== Performance Test ==="
    
    local postgres_url="postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB?sslmode=disable"
    
    # Test with notifications enabled
    echo "Testing with notifications ENABLED..."
    ./bin/kine --endpoint="$postgres_url" --listen-address="127.0.0.1:12379" --debug > kine_perf.log 2>&1 &
    KINE_PID=$!
    
    sleep 3
    
    # Run quick performance test
    local start_time=$(date +%s%N)
    for i in {1..10}; do
        etcdctl --endpoints=127.0.0.1:12379 put "perf-key-$i" "value-$i" >/dev/null
    done
    local end_time=$(date +%s%N)
    local duration_ms=$(( (end_time - start_time) / 1000000 ))
    
    echo "✓ 10 PUT operations completed in ${duration_ms}ms"
    
    # Check notification metrics
    local notifications=$(curl -s http://127.0.0.1:8080/metrics | grep "kine_notifications_total" | grep "success" | awk '{print $2}' || echo "0")
    echo "✓ Received $notifications successful notifications"
    
    kill $KINE_PID 2>/dev/null || true
    wait $KINE_PID 2>/dev/null || true
    KINE_PID=""
    
    echo "✓ Performance test completed"
}

# Main test execution
main() {
    echo "Starting PostgreSQL integration tests..."
    
    # Prerequisites
    check_postgres
    build_kine
    create_test_db
    
    # Test 1: Notifications enabled
    test_notifications "false" "Event-driven notifications enabled"
    
    # Test 2: Notifications disabled  
    test_notifications "true" "Polling mode (notifications disabled)"
    
    # Test 3: Performance test
    performance_test
    
    echo "=== All Tests Completed Successfully ==="
    echo
    echo "Summary:"
    echo "✓ PostgreSQL connectivity verified"
    echo "✓ Event-driven notification mode tested"
    echo "✓ Polling mode tested"
    echo "✓ Basic etcd operations working"
    echo "✓ Watch functionality working"
    echo "✓ Metrics collection working"
    echo "✓ Performance test completed"
    echo
    echo "The PostgreSQL LISTEN/NOTIFY implementation is working correctly!"
}

# Help function
show_help() {
    cat << EOF
PostgreSQL Integration Test for Kine Notifications

This script tests the LISTEN/NOTIFY implementation with a real PostgreSQL database.

Usage: $0

Environment Variables:
  POSTGRES_HOST      PostgreSQL host (default: localhost)
  POSTGRES_PORT      PostgreSQL port (default: 5432)
  POSTGRES_USER      PostgreSQL user (default: postgres)
  POSTGRES_PASSWORD  PostgreSQL password (default: postgres)

Prerequisites:
  - PostgreSQL server running and accessible
  - etcdctl installed
  - curl installed
  - nc (netcat) installed

The test will:
1. Create a temporary test database
2. Test Kine with notifications enabled
3. Test Kine with notifications disabled
4. Verify basic etcd operations work
5. Test watch functionality
6. Check metrics collection
7. Run performance comparison
8. Clean up test database

Examples:
  $0                                    # Use default PostgreSQL connection
  POSTGRES_HOST=db.example.com $0       # Use remote PostgreSQL
  POSTGRES_PASSWORD=secret $0           # Use custom password

EOF
}

# Parse command line arguments
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    *)
        main "$@"
        ;;
esac